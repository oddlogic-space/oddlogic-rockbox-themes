+#ifdef SIMULATOR
+/* ---- scripted test driver (added for headless theme testing): RB_SIMCMD=<file> of commands, one per line:
+   sleep MS | down X Y | move X Y | up X Y | key NAME(f5,f4,up,down,left,right,enter,esc) | quit */
+#include <stdlib.h>
+#include <unistd.h>
+static int sim_cmd_thread(void *arg)
+{
+    (void)arg;
+    const char *path = getenv("RB_SIMCMD");
+    if (!path) return 0;
+    while (!SDL_WasInit(SDL_INIT_VIDEO)) SDL_Delay(100);
+    SDL_Delay(4000);
+    FILE *f = fopen(path, "r"); if (!f) return 0;
+    char line[256];
+    while (fgets(line, sizeof line, f))
+    {
+        char cmd[32] = "", a[32] = ""; int x = 0, y = 0; SDL_Event e; memset(&e, 0, sizeof e);
+        int n = sscanf(line, "%31s %d %d", cmd, &x, &y);
+        if (n < 1) continue;
+        if (!strcmp(cmd, "sleep")) SDL_Delay(x);
+        else if (!strcmp(cmd, "down") || !strcmp(cmd, "up")) {
+            e.type = cmd[0]=='d' ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP; e.button.button = SDL_BUTTON_LEFT;
+            e.button.state = cmd[0]=='d' ? SDL_PRESSED : SDL_RELEASED; e.button.x = x; e.button.y = y; e.button.clicks = 1; SDL_PushEvent(&e);
+        } else if (!strcmp(cmd, "move")) {
+            e.type = SDL_MOUSEMOTION; e.motion.state = SDL_BUTTON_LMASK; e.motion.x = x; e.motion.y = y; SDL_PushEvent(&e);
+        } else if (!strcmp(cmd, "key")) {
+            sscanf(line, "%*s %31s", a);
+            int k = !strcmp(a,"f5")?SDLK_F5 : !strcmp(a,"f4")?SDLK_F4 : !strcmp(a,"up")?SDLK_UP : !strcmp(a,"down")?SDLK_DOWN :
+                    !strcmp(a,"left")?SDLK_LEFT : !strcmp(a,"right")?SDLK_RIGHT : !strcmp(a,"enter")?SDLK_RETURN : !strcmp(a,"esc")?SDLK_ESCAPE : !strcmp(a,"tab")?SDLK_TAB : !strcmp(a,"pgup")?SDLK_PAGEUP : !strcmp(a,"pgdn")?SDLK_PAGEDOWN : 0;
+            if (k) { e.type = SDL_KEYDOWN; e.key.keysym.sym = k; e.key.state = SDL_PRESSED; SDL_PushEvent(&e);
+                     SDL_Delay(60); e.type = SDL_KEYUP; e.key.state = SDL_RELEASED; SDL_PushEvent(&e); }
+        } else if (!strcmp(cmd, "quit")) { e.type = SDL_QUIT; SDL_PushEvent(&e); }
+    }
+    fclose(f); return 0;
+}
+__attribute__((constructor)) static void sim_cmd_start(void) { if (getenv("RB_SIMCMD")) SDL_CreateThread(sim_cmd_thread, "simcmd", NULL); }
+#endif
